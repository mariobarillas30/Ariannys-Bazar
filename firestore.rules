rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regla global: Permitir lectura y escritura a las colecciones del sistema
    // para garantizar sincronización en tiempo real en todos los modos (Demo, Auth, POS)
    match /{document=**} {
      allow read, write: if true;
    }

    // Colección 'users' - Perfiles y Roles de Usuario
    match /users/{userId} {
      allow read, write: if true;
    }

    // Colección 'products' - Catálogo de Inventario
    match /products/{productId} {
      allow read, write: if true;
    }

    // Colección 'sales' - Registro de Ventas
    match /sales/{saleId} {
      allow read, write: if true;
    }

    // Colección 'customers' - Clientes
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Colección 'customerPayments' - Pagos de Clientes
    match /customerPayments/{paymentId} {
      allow read, write: if true;
    }

    // Colección 'cashRegisters' - Apertura y Cierre de Caja
    match /cashRegisters/{registerId} {
      allow read, write: if true;
    }

    // Colección 'cashMovements' - Ingresos / Retiros de Caja
    match /cashMovements/{movementId} {
      allow read, write: if true;
    }

    // Colección 'stockMovements' - Kardex de Inventario
    match /stockMovements/{movementId} {
      allow read, write: if true;
    }
  }
}
